VITE_ATM_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_ATM_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_ATM_APP_URL=https://your-atm-status-url

# Build-only (no VITE_ prefix, so it never reaches the browser). A GitHub token with no scopes
# (or read:user) lets the activity graph include private contribution counts. Optional: without
# it the build reads the public profile calendar.
GITHUB_TOKEN=
