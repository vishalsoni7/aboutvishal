# Netlify response headers. See CLAUDE.md "Old portfolio at /v1" for the routing side.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()

# Vite puts a content hash in these filenames, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts. Rename the file if a font is ever replaced.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The old portfolio stays reachable but out of search results.
/v1/*
  X-Robots-Tag: noindex
